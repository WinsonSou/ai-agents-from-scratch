# Local LLM Configuration
# For Ollama (default port 11434)
LOCAL_LLM_URL=http://localhost:11434/v1

# For LM Studio (default port 1234)
# LOCAL_LLM_URL=http://localhost:1234/v1

# Model name (must match your local model)
# For Ollama: use the model name as shown in `ollama list`
# For LM Studio: use the model identifier from the server
LOCAL_LLM_MODEL=qwen3:1.7b

# API Key (optional for local LLMs, required for cloud providers)
# For OpenAI: sk-...
# For Groq: gsk_...
# For Together AI: your API key
LOCAL_LLM_API_KEY=
